# Verified stand-1cdbd44567f0 wiring, 2026-11-14.
# Apply after sdkconfig.defaults for a fresh wired-device configuration.
CONFIG_STAND_SERVO_MANUAL_CONTROL=y
CONFIG_STAND_PAN_GPIO=4
CONFIG_STAND_TILT_GPIO=5
# CONFIG_STAND_SERVO_OUTPUT is not set
CONFIG_STAND_CHARGER_MANUAL_CONTROL=y
CONFIG_STAND_CHARGER_OUTPUT=y
CONFIG_STAND_CHARGER_GPIO=6
# CONFIG_STAND_CHARGER_ACTIVE_LOW is not set
CONFIG_STAND_CHARGE_START_PERCENT=40
CONFIG_STAND_CHARGE_STOP_PERCENT=80
