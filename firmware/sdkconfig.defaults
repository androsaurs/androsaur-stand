# ESP32-S3-WROOM-1 N16R8 (DevKitC-1): 16 MB flash, 8 MB octal PSRAM (GPIO35-37 are taken by it).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Two OTA slots of 4 MB: the enclosure stays closed, updates come over Wi-Fi.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The UART port of the board is the console (UART0): logs and flashing over the same cable.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Reserve room for HTTPS initialization and diagnostic NVS writes in IP events.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144
# Temporary bring-up ceiling, including PHY initialisation (not just a post-start API setting).
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=10
# TLS sessions use the available 8 MB PSRAM instead of competing with Wi-Fi/BLE for internal RAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y
CONFIG_MBEDTLS_PEM_WRITE_C=y
